rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customer availability enquiries: Anyone can submit an enquiry; only admin can read/manage
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.customerName != null && request.resource.data.phone != null;
      allow read, update, delete: if request.auth != null && (request.auth.token.email == "admin@lakshmistores.com" || request.auth.token.email == "aliali@gmail.com");
    }

    // Orders collection: Public create with valid email; Admin or owner read/delete
    match /order/{orderId} {
      allow create: if request.resource.data.email != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userid || request.auth.token.email == "admin@lakshmistores.com" || request.auth.token.email == "aliali@gmail.com");
      allow update, delete: if request.auth != null && (request.auth.token.email == "admin@lakshmistores.com" || request.auth.token.email == "aliali@gmail.com");
    }

    // Catalogue cache / configuration: Public read; Admin write
    match /catalogue_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == "admin@lakshmistores.com" || request.auth.token.email == "aliali@gmail.com");
    }

    // Default rule: Public read for storefront; Admin write
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == "admin@lakshmistores.com" || request.auth.token.email == "aliali@gmail.com");
    }
  }
}
