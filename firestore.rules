rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request is from an authorized admin user via custom claim or Firestore user role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        ) ||
        request.auth.token.email == "admin@gmail.com" ||
        request.auth.token.email == "lakshmistoresonline@gmail.com" ||
        request.auth.token.email == "admin@vastraa.com" ||
        request.auth.token.email == "admin@lakshmistores.com" ||
        request.auth.token.email == "aliali@gmail.com"
      );
    }

    // Helper function to check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection: Admin read/write; Owner read/write
    match /users/{userId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated();
    }

    // Customer enquiries & order review requests: Customer read own; Admin full manage
    match /enquiries/{enquiryId} {
      allow create: if isAuthenticated() || (
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.phone.size() >= 10
      );
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.customerUid ||
          request.auth.token.email == resource.data.customerEmail ||
          request.auth.token.email == resource.data.email
        )
      );
      allow update, delete: if isAdmin();
    }

    // Automated job logs (WhatsApp & Email): Create allowed for app notifications; Read/Manage strictly Admin
    match /whatsapp_jobs/{jobId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /email_jobs/{jobId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders collection: Customer read own; Admin full manage
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.customerUid);
      allow update, delete: if isAdmin();
    }

    // Products / Storefront inventory data: Public read; Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catalogue cache / configuration: Public read; Admin write
    match /catalogue_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Strict fallback rule: Admin read/write only for all other documents
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
