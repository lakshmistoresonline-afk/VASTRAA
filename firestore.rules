rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request is from an authorized admin user
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "lakshmistoresonline@gmail.com" ||
        request.auth.token.email == "admin@vastraa.com" ||
        request.auth.token.email == "admin@lakshmistores.com" ||
        request.auth.token.email == "aliali@gmail.com"
      );
    }

    // Customer availability enquiries: Public creation with shape validation; Private admin read/manage
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.customerName is string &&
                       request.resource.data.phone is string &&
                       request.resource.data.customerName.size() > 0 &&
                       request.resource.data.phone.size() >= 10;
      allow read, update, delete: if isAdmin();
    }

    // Orders collection: Public create with valid email; Admin or owner read/delete
    match /order/{orderId} {
      allow create: if request.resource.data.email is string;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userid);
      allow update, delete: if isAdmin();
    }

    // Catalogue cache / configuration: Public read; Admin write
    match /catalogue_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products / Storefront data: Public read; Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catch-all fallback rule: Public read for storefront; Admin write
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
